# Copia a .env.local. Ningún valor real se versiona (SEC-03, KEY-03).
APP_ENV=development                      # development | test | staging | production
DATABASE_URL=postgres://contigo_app@127.0.0.1:5433/contigo_dev   # rol de la app, sin BYPASSRLS (AUTHZ-05)
MIGRATION_DATABASE_URL=postgres://postgres@127.0.0.1:5433/contigo_dev   # solo para scripts de migración
AUTH_ALLOWED_DOMAIN=axexo.com            # dominio de Google Workspace permitido (AUTHZ-01)
SUPABASE_URL=                            # staging: proveedor OIDC detrás de src/server/adapters/identity.ts
SUPABASE_PUBLISHABLE_KEY=
BOOTSTRAP_ADMIN_EMAILS=                  # correos que entran como admin en su primer login con SSO
DEMO_PERSONAS=0                          # 1 = login con personas sintéticas. Prohibido en production.
