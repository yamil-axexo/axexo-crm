{
  "openapi": "3.1.0",
  "info": {
    "title": "axexo CONTIGO read API",
    "version": "1.0.0",
    "description": "Read-only, versioned, one market per key. Keys are created and rotated in Administration."
  },
  "paths": {
    "/api/v1/accounts": {
      "get": {
        "summary": "Merchants in the key’s market. No phones, emails or contacts.",
        "security": [
          {
            "bearer": [
              "accounts:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "next_cursor from the previous page."
          },
          {
            "name": "lifecycle",
            "in": "query",
            "description": "Lifecycle stage.",
            "schema": {
              "type": "string",
              "enum": [
                "prospect",
                "onboarding",
                "active",
                "at_risk",
                "inactive",
                "churned"
              ]
            }
          },
          {
            "name": "kind",
            "in": "query",
            "description": "Level.",
            "schema": {
              "type": "string",
              "enum": [
                "organization",
                "distributor",
                "chain",
                "store"
              ]
            }
          },
          {
            "name": "updated_since",
            "in": "query",
            "description": "Only what changed since that moment (ISO 8601 with offset).",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of records, oldest first.",
            "headers": {
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "next_cursor"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/accounts"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "invalid_filter: A filter, the cursor or the limit is not valid."
          },
          "401": {
            "description": "unauthorized: The key is missing or not valid."
          },
          "403": {
            "description": "forbidden: The key lacks that scope, or its creator no longer has access to that market."
          },
          "429": {
            "description": "rate_limited: Too many requests. Wait the seconds given in Retry-After."
          }
        }
      }
    },
